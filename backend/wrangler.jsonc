{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wtm-backend",
  "account_id": "b732618f85b1356a957deddd468c4f58",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "observability": {
    "enabled": true
  },
  "routes": [{ "pattern": "api.webtm.io", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wtm",
      "database_id": "0e4724c9-5630-40b5-957d-6547cc14d649",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "wtm-pages"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "611be2a3c8cf4b48a1eb9e97329bd090"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["0 4 * * *"]
  },
  "vars": {
    "SUMMARY_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "DEFAULT_RETENTION_DAYS": "90"
  }
}
