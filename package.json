{
  "name": "webtimemachine",
  "private": true,
  "version": "4.0.0",
  "description": "Web Time Machine v4 — passively capture, sync, search, summarize, and recall your browsing history across devices.",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev:backend": "pnpm --filter @wtm/backend dev",
    "deploy:backend": "pnpm --filter @wtm/backend run deploy",
    "dev:web": "pnpm --filter @wtm/web dev",
    "build:chrome": "pnpm --filter @wtm/extension-chrome build",
    "build:firefox": "pnpm --filter @wtm/extension-firefox build",
    "package:extensions": "pnpm --filter @wtm/extension-chrome package && pnpm --filter @wtm/extension-firefox package",
    "sync:skills": "node scripts/sync-recall-skills.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
